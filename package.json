{
  "name": "newsai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI news for Indian builders \u2014 agents first",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "digest": "npm run build && node --env-file-if-exists=.env dist/pipeline.js",
    "render": "npm run build && node dist/render.js",
    "daily": "npm run digest && npm run render",
    "preview": "node scripts/preview.mjs",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "send": "npm run build && node --env-file-if-exists=.env dist/send.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "postgres": "^3.4.9"
  }
}
