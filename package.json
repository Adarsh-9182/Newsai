{
  "name": "newsai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI news for Indian builders — agents first",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "digest": "npm run build && node --env-file-if-exists=.env dist/pipeline.js",
    "render": "npm run build && node dist/render.js",
    "daily": "npm run digest && npm run render"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0"
  }
}
