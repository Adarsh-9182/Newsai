{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": false,
    "skipLibCheck": true,
    "lib": ["es2023"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
