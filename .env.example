# Only secret this project needs. Get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-haiku-4-5 — the cheapest model that can do this job.
# Switch to claude-sonnet-5 if the summaries read badly.
NEWSAI_MODEL=claude-haiku-4-5

# Optional. Hard ceiling on how many stories get summarised per run, so a
# busy news day can never cost more than you expect.
NEWSAI_MAX_STORIES=25
