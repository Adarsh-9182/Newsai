# Only secret this project needs. Get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Bulk summariser. Cheapest model that can compress an abstract.
NEWSAI_MODEL=claude-haiku-4-5

# The long read. Judgement, not compression — worth a better model.
NEWSAI_ANALYSIS_MODEL=claude-sonnet-5

# Hard ceilings, applied before anything is sent, so a busy news day
# can never cost more than a quiet one.
NEWSAI_MAX_STORIES=25
NEWSAI_ANALYSIS_DEPTH=5

# Accounts, saved stories and the email list. Any Postgres works — Neon or
# Supabase — and the same code runs on both. Leave unset to run without accounts
# locally (an in-memory database is used); on Vercel, unset means the API says
# "accounts are not switched on" rather than silently losing sign-ups.
#   Neon:     the pooled connection string from the dashboard
#   Supabase: Project Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL=
