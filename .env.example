# Gemini API key from Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Story and analysis ceilings. Applied before any model request.
NEWSAI_MAX_STORIES=25
NEWSAI_ANALYSIS_DEPTH=5
# Optional model overrides
# NEWSAI_SUMMARY_MODEL=gemini-3.1-flash-lite
# NEWSAI_ANALYSIS_MODEL=gemini-3.1-flash-lite

# Accounts and saved stories. Any Postgres works: Neon or Supabase.
# Leave unset for local in-memory preview; Vercel returns 503 until configured.
DATABASE_URL=

# Email subscription confirmation and sending
NEWSAI_MAIL_SECRET=
RESEND_API_KEY=
NEWSAI_MAIL_FROM=newsai <digest@newsai.co.in>
# Public URL used in confirmation links, canonical URLs and the feed
NEWSAI_SITE_URL=https://newsai.co.in
